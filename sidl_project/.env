# SiDL — Variables de Entorno
# ═══════════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores

# API Key de Gemini 1.5 Pro
# Obtén la tuya en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Puerto del servidor (opcional, por defecto 8000)
PORT=8000

# Host (0.0.0.0 para aceptar conexiones externas)
HOST=0.0.0.0
