# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE SIDL MVC — Variables de Entorno (.env)
# ═══════════════════════════════════════════════════════════════════════════════

# ─── PROVEEDOR DE IA (Elige uno: gemini, groq, huggingface)  ───────────────────
# Si no especificas AI_PROVIDER, el sistema usa el primero disponible por orden:
# 1. Gemini (GEMINI_API_KEY)
# 2. Groq (GROQ_API_KEY)
# 3. Hugging Face (HUGGINGFACE_API_KEY)

AI_PROVIDER=huggingface        # Valores: gemini, groq, huggingface, auto

# ─── GOOGLE GEMINI ─────────────────────────────────────────────────────────────
# Gratis hasta 1M de tokens/mes. Mejor para texto + visión.
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL_TEXT=gemini-2.0-flash
GEMINI_MODEL_VISION=gemini-2.0-flash

# ─── GROQ LLAMA ────────────────────────────────────────────────────────────────
# Gratis y ultrarrápido (<1s). Perfecto para análisis bajo demanda.
# Obtén tu API Key en: https://console.groq.com/keys
GROQ_API_KEY=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
GROQ_MODEL_TEXT=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# ─── HUGGING FACE QWEN ─────────────────────────────────────────────────────────
# Open-source, bueno para privacidad + visión multimodal.
# Obtén tu API Key en: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=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
HUGGINGFACE_MODEL_TEXT=Qwen/Qwen2.5-VL-7B-Instruct:hyperbolic
HUGGINGFACE_MODEL_VISION=Qwen/Qwen2.5-VL-7B-Instruct:hyperbolic

# ─── SERVER ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ═══════════════════════════════════════════════════════════════════════════════
# INSTRUCCIONES:
# 1. Copia este archivo a .env (en la misma carpeta)
# 2. Elige UN proveedor y obtén su API Key
# 3. Pega la API Key en la línea correspondiente
# 4. Opcionalmente, establece AI_PROVIDER=gemini|groq|huggingface
# 5. Guarda el archivo
# 6. Ejecuta: uvicorn main:app --reload
# ═══════════════════════════════════════════════════════════════════════════════
